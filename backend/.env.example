# --- LLM ---
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Explicit per-agent routing. This is NOT fallback order: each agent uses
# exactly the provider/model below unless you override it.
LLM_PROVIDER_NORMALIZATION=groq
LLM_MODEL_NORMALIZATION=openai/gpt-oss-20b
LLM_PROVIDER_MEMORY_RELEVANCE=openrouter
LLM_MODEL_MEMORY_RELEVANCE=nvidia/nemotron-3.5-lightning:free
LLM_PROVIDER_RAG_RERANK=openrouter
LLM_MODEL_RAG_RERANK=nvidia/nemotron-3.5-lightning:free
LLM_PROVIDER_ANALYST=nvidia
LLM_MODEL_ANALYST=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_PROVIDER_GUARDRAIL=groq
LLM_MODEL_GUARDRAIL=openai/gpt-oss-120b
LLM_PROVIDER_STRESS_TEST=groq
LLM_MODEL_STRESS_TEST=openai/gpt-oss-20b
LLM_PROVIDER_REPORT_WRITER=openrouter
LLM_MODEL_REPORT_WRITER=nvidia/nemotron-3.5-lightning:free
LLM_PROVIDER_CHAT=groq
LLM_MODEL_CHAT=openai/gpt-oss-20b

# When unset, services/llm.py runs in deterministic mock mode so the pipeline
# is runnable and testable without any network access or API key.
LLM_MOCK_MODE=auto        # auto | on | off  (auto = on when all provider keys are empty)

DEMO_FAST_MODE=0          # reserved for older Anthropic-only configs

# --- Sponsor integrations (optional; graceful fallback if unset) ---
TAVILY_API_KEY=

# --- Voice ---
# Defaults are the local open-source stack: Kokoro-82M (Apache-2.0) for
# text-to-speech and faster-whisper (MIT) for speech-to-text. Both run
# offline with no API key and no per-call cost. Needs ffmpeg on PATH plus a
# one-time `python scripts/fetch_voice_models.py` to download the weights.
VOICE_TTS_PROVIDER=kokoro      # kokoro | elevenlabs
VOICE_STT_PROVIDER=whisper     # whisper | elevenlabs

KOKORO_VOICE=af_heart          # af_heart, af_bella, am_michael, bf_emma, ...
KOKORO_SPEED=1.0               # 0.5 - 2.0
KOKORO_MODEL_FILE=kokoro-v1.0.onnx   # or kokoro-v1.0.int8.onnx (3x smaller, faster, slightly rougher)

WHISPER_MODEL=small.en         # tiny.en | base.en | small.en | medium.en | large-v3
WHISPER_COMPUTE_TYPE=int8      # int8 on CPU; float16 on a CUDA GPU
WHISPER_DEVICE=cpu

# Only needed when a VOICE_*_PROVIDER above is set to "elevenlabs".
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Storage ---
DATABASE_URL=sqlite:///./ledgerlight.db
CHROMA_PERSIST_DIR=./.chroma

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
