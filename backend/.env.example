# --- LLM ---
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Explicit per-agent routing. This is NOT fallback order: each agent uses
# exactly the provider/model below unless you override it.
LLM_PROVIDER_NORMALIZATION=groq
LLM_MODEL_NORMALIZATION=openai/gpt-oss-20b
LLM_PROVIDER_MEMORY_RELEVANCE=openrouter
LLM_MODEL_MEMORY_RELEVANCE=nvidia/nemotron-3.5-lightning:free
LLM_PROVIDER_RAG_RERANK=openrouter
LLM_MODEL_RAG_RERANK=nvidia/nemotron-3.5-lightning:free
LLM_PROVIDER_ANALYST=groq
LLM_MODEL_ANALYST=openai/gpt-oss-120b
LLM_PROVIDER_GUARDRAIL=groq
LLM_MODEL_GUARDRAIL=openai/gpt-oss-120b
LLM_PROVIDER_STRESS_TEST=groq
LLM_MODEL_STRESS_TEST=openai/gpt-oss-20b
LLM_PROVIDER_REPORT_WRITER=openrouter
LLM_MODEL_REPORT_WRITER=nvidia/nemotron-3.5-lightning:free

# When unset, services/llm.py runs in deterministic mock mode so the pipeline
# is runnable and testable without any network access or API key.
LLM_MOCK_MODE=auto        # auto | on | off  (auto = on when all provider keys are empty)

DEMO_FAST_MODE=0          # reserved for older Anthropic-only configs

# --- Sponsor integrations (optional; graceful fallback if unset) ---
TAVILY_API_KEY=
ELEVENLABS_API_KEY=

# --- Storage ---
DATABASE_URL=sqlite:///./ledgerlight.db
CHROMA_PERSIST_DIR=./.chroma

# Data ownership. AUTH0_REQUIRED=1 makes every record scoped to the signed-in
# user's Auth0 `sub`. DEFAULT_USER_ID is only used while Auth0 is unconfigured
# (or AUTH0_REQUIRED=0); LEGACY_USER_ID owns rows migrated from before
# per-user scoping existed.
DEFAULT_USER_ID=local_dev_user
LEGACY_USER_ID=legacy_user

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Auth0 (login gate for the whole API) ---
# From the Auth0 dashboard: Applications > your app > Settings.
# Callback/logout URLs must be {APP_BASE_URL}/auth/callback and
# {APP_BASE_URL}/auth/logout. Allowed Web Origins should include APP_BASE_URL.
# APP_BASE_URL is the FastAPI server (it hosts /auth/callback).
# APP_URL is the Ledgerlight frontend, where a successful sign-in lands.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Signs/encrypts the session cookie. Generate with: openssl rand -hex 64
# Changing it invalidates every existing session.
SESSION_SECRET=

# Backend origin -- serves /auth/login, /auth/callback, /auth/logout.
APP_BASE_URL=http://localhost:8000
# Frontend origin -- the "original application" loaded after sign-in.
APP_URL=http://localhost:5173

# Optional: set to 0 to keep the API open while the Auth0 tenant is being
# configured. Default 1 (enforce) as soon as the four values above are real.
AUTH0_REQUIRED=1

# Optional: set to 1 to sign out of the upstream IdP (Google, etc.) as well as
# Auth0. Default 0: signing out of Ledgerlight must not sign the user out of
# Google everywhere else in the browser.
AUTH0_FEDERATED_LOGOUT=0

# Optional: `prompt` sent with /authorize. `select_account` makes Google show
# its account chooser instead of silently reusing the last account. Set to an
# empty value to omit the parameter. If Auth0 still skips the chooser, add
# "upstream_params": {"prompt": {"value": "select_account"}} to the Google
# connection (Auth0 Dashboard > Authentication > Social > Google > Advanced,
# or the Management API), or set this to `login` to force the Auth0 login page.
AUTH0_LOGIN_PROMPT=select_account

# Optional: seconds of clock drift tolerated when verifying the ID token's
# `iat`. Without it, a host clock a few seconds behind Auth0 makes every login
# fail with "The token is not yet valid (iat)". Default 120.
AUTH0_CLOCK_SKEW_LEEWAY_SECONDS=120
